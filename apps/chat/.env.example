# ─────────────────────────────────────────────
# Anvil Chat — Environment Configuration
# Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────

# ── AI / LLM ──────────────────────────────────
# OpenAI-compatible endpoint (default: OpenAI)
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# Your API key (OpenAI or compatible provider)
OPENAI_API_KEY=sk-...
# Model to use (gpt-4o recommended)
AI_MODEL=gpt-4o

# ── Anvil Internal APIs ────────────────────────
# These are the base URLs for Anvil's micro-service layer.
# If running the full Anvil stack locally, these point to localhost.
# In production, these are the deployed service endpoints.
ANVIL_GMAIL_API=http://localhost:3001
ANVIL_DRIVE_API=http://localhost:3002
ANVIL_CALENDAR_API=http://localhost:3003
ANVIL_DOCS_API=http://localhost:3004

# ── Voice ──────────────────────────────────────
# Local Whisper STT endpoint (optional; falls back to OpenAI Whisper API)
# Start with: whisper-server --host 0.0.0.0 --port 8080
WHISPER_LOCAL_URL=http://localhost:8080/inference

# ── Web Search ─────────────────────────────────
# Brave Search API key (for web_search tool)
# Get one at: https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=BSA...
