# Environment Configuration
# Copy to .env and fill in values

# ── PostgreSQL ──
POSTGRES_USER=anvil
POSTGRES_PASSWORD=anvil_secret
POSTGRES_DB=anvil
DATABASE_URL=postgresql://anvil:anvil_secret@localhost:5432/anvil

# ── Keycloak ──
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=anvil
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_ID=anvil-app
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── MinIO / S3 ──
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=anvil_minio
MINIO_SECRET_KEY=anvil_minio_secret
MINIO_BUCKET=anvil-drive

# ── Meilisearch ──
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=anvil_meili_secret

# ── Stalwart Mail ──
STALWART_URL=http://localhost:8082
STALWART_ADMIN_SECRET=anvil_stalwart_secret

# ── App Settings ──
NODE_ENV=development
NEXTAUTH_SECRET=CHANGE_ME_TO_RANDOM_STRING
APP_URL=http://localhost:3000

# ── External APIs ──
YOUTUBE_API_KEY=OPTIONAL
RAPIDAPI_KEY=OPTIONAL
MAPTILER_KEY=OPTIONAL
