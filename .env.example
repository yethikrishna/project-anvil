# ═══════════════════════════════════════════════════════════════
# Anvil Environment Configuration
# Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════

# ── Domain ──
ANVIL_DOMAIN=localhost
ACME_EMAIL=admin@example.com

# ── Database (PostgreSQL 16) ──
DATABASE_URL=postgresql://anvil:anvil_secret@localhost:5432/anvil
DB_USER=anvil
DB_PASSWORD=anvil_secret

# ── Cache (Valkey 8 / Redis) ──
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── Object Storage (MinIO) ──
MINIO_ENDPOINT=localhost:9000
MINIO_USER=anvil
MINIO_PASSWORD=anvil_secret_key
MINIO_USE_SSL=false

# ── Search (Meilisearch) ──
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=anvil_meili_key

# ── Identity (Keycloak) ──
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=anvil

# ── Mail (Stalwart) ──
SMTP_HOST=localhost
SMTP_PORT=587
IMAP_HOST=localhost
IMAP_PORT=993
MAIL_DOMAIN=anvil.local

# ── Auth ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=  # Generate: openssl rand -hex 32

# ── Stripe Billing (optional) ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-12-18.acacia

# ── HSM / Key Management (enterprise) ──
HSM_TYPE=soft-hsm  # aws-kms | gcp-kms | azure-keyvault | soft-hsm
HSM_PIN=
HSM_KEY_PREFIX=anvil_

# ── Data Residency ──
PRIMARY_REGION=us-east-1

# ── AI (optional) ──
OPENAI_API_KEY=
AI_MODEL=gpt-4

# ── Google Workspace Migration ──
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_ADMIN_EMAIL=
ANVIL_TENANT_ID=

# ── Monitoring (SOC 2 mode) ──
GRAFANA_PASSWORD=
PROMETHEUS_ENABLED=false

# ── Compliance ──
COMPLIANCE_MODE=standard  # standard | hipaa | gdpr | soc2
AUDIT_RETENTION_DAYS=2190
AUDIT_IMMUTABLE=false

# ── Backup ──
BACKUP_ENCRYPTION_KEY=
S3_BACKUP_URL=
